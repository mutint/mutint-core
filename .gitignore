# Python
.venv

# Managed environments: env/ holds the pinned interpreter, the venv (env/main), the
# components' tools (env/tools) and the PostgreSQL server. `rm -rf env` is the reset.
env/

# Everything a checkout would lose: the database cluster (data/db) and the file store
# (data/store, MUTINT_STORE_DIR). Kept apart from env/ so resetting the tools cannot take
# the data with it.
/data/

# Operator-local notes from the pre-publication security audit. Never committed.
/audit_local/

# Claude Code local state. `worktrees/` holds embedded git repos -- `git add -A` picks them
# up as gitlinks, which is how one nearly landed in a commit. `settings.local.json` is
# machine-local by convention; a shared .claude/settings.json can still be committed.
.claude/worktrees/
.claude/settings.local.json
.claude/.DS_Store

# `./mutint docs`. The sources are docs/ and mkdocs.yml; these two are generated --
# .docs-build/ is the merged tree of symlinks plus a generated config, site/ the output.
/.docs-build/
/site/
